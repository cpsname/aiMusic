{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genaistudio/schema/analysis_report_v1.json",
  "title": "竞品素材拆解报告 Schema v1 (material_analysis_v1)",
  "description": "M1 多模态拆解 step4 输出契约 + 前端 Schema 驱动渲染锚点。枚举与 internal/creation/domain/postprocess/analysis_report_v1.go 由 analysis_report_v1_guard_test.go 锁死一致。report_schema_version='v1'。",
  "type": "object",
  "additionalProperties": false,
  "required": ["report", "scores"],
  "properties": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "composition", "shots", "highlights", "risks"],
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["genre", "core_appeal", "summary"],
          "properties": {
            "genre": {"type": "string", "description": "题材 (如 仙侠/传奇/模拟经营)"},
            "core_appeal": {"type": "string", "description": "内核卖点一句话"},
            "summary": {"type": "string", "description": "整体概述 (≤500字)"}
          }
        },
        "composition": {
          "type": "array",
          "minItems": 1,
          "description": "成分构成; 所有 percent 之和约等于 100 (容差 [95,105])",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "percent"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["gameplay", "ui_capture", "live_action", "cg_animation", "text_card", "talking_head", "mixed_edit", "other"]
              },
              "percent": {"type": "number", "minimum": 0, "maximum": 100},
              "note": {"type": "string"}
            }
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "description": "分镜; index 从1连续递增, 时间窗按时序不重叠且 end_ms 不超素材时长 (容差 1.5s)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "start_ms", "end_ms", "visual", "function"],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "start_ms": {"type": "integer", "minimum": 0},
              "end_ms": {"type": "integer", "minimum": 0},
              "visual": {"type": "string"},
              "audio_line": {"type": "string"},
              "on_screen_text": {"type": "string"},
              "function": {
                "type": "string",
                "enum": ["hook", "pain_point", "showcase", "social_proof", "benefit", "cta", "transition", "other"]
              },
              "frame_refs": {"type": "array", "items": {"type": ["string", "integer"]}, "description": "模型自填前向引用(装饰性,平台不消费);元素类型随模型而异(字符串/分镜序号)"}
            }
          }
        },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point"],
            "properties": {
              "point": {"type": "string"},
              "evidence_shot": {"type": "integer", "minimum": 0, "description": "对应分镜 index; 0=未指定"}
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "severity"],
            "properties": {
              "point": {"type": "string"},
              "severity": {"type": "string", "enum": ["info", "warn", "high"]},
              "evidence_shot": {"type": "integer", "minimum": 0, "description": "对应分镜 index; 0=未指定"}
            }
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "info_density", "visual_impact", "pacing", "conversion", "compliance"],
      "properties": {
        "hook": {"$ref": "#/definitions/score_cell"},
        "info_density": {"$ref": "#/definitions/score_cell"},
        "visual_impact": {"$ref": "#/definitions/score_cell"},
        "pacing": {"$ref": "#/definitions/score_cell"},
        "conversion": {"$ref": "#/definitions/score_cell"},
        "compliance": {"$ref": "#/definitions/score_cell"}
      }
    }
  },
  "definitions": {
    "score_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stars", "reason"],
      "properties": {
        "stars": {"type": "integer", "minimum": 1, "maximum": 5},
        "reason": {"type": "string"}
      }
    }
  }
}
